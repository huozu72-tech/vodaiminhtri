<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="💳 Đặt Hàng &amp; Thanh Toán Hóa Đơn"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            tools:text="Hóa đơn Bàn 12 • Tổng cộng: 210.000 đ (5 món)" />

        <!-- Số bàn: người dùng tự nhập -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTableNumber"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Số bàn phục vụ (ví dụ: 12)"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTableNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phương thức thanh toán (Mục 4.2.5 & Bảng 3.4) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Phương thức thanh toán:"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPayQr"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🏦 Chuyển khoản QR"
                android:textSize="11sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPayCash"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 Tiền mặt tại bàn"
                android:textSize="11sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPayWallet"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Ví MoMo / ZaloPay"
                android:textSize="11sp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- QR Code Box -->
        <LinearLayout
            android:id="@+id/layoutQrBox"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgQrCode"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@color/white"
                android:contentDescription="Mã QR Thanh Toán"
                android:padding="4dp"
                android:src="@drawable/ic_restaurant" />

            <TextView
                android:id="@+id/tvQrBoxLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mã QR VietQR Ngân Hàng"
                android:textColor="@color/ai_button_orange"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- URL mã QR VietQR (hiển thị khi khách bấm tạo đơn) -->
        <TextView
            android:id="@+id/tvQrUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/gray_text"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Link VietQR: https://img.vietqr.io/image/..."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenQrUrl"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="🌐 Mở Bằng Trình Duyệt / App Ngân Hàng"
            android:textAllCaps="false"
            android:textColor="@color/ai_button_orange"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="8dp"
            app:strokeColor="@color/ai_border_orange"
            tools:visibility="visible" />

        <!-- Nút tạo đơn & lấy mã QR trước khi xác nhận chuyển tiền -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateOrderQr"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/ai_button_orange"
            android:text="1. Nhận Mã QR &amp; Tạo Đơn Hàng"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Sau khi kiểm tra thông tin thanh toán, nhấn nút bên dưới để hoàn tất đặt món."
            android:textColor="@color/gray_text"
            android:textSize="11sp" />

        <!-- Confirm Payment Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPayment"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/banner_red"
            android:text="2. Hoàn Tất Đặt Hàng &amp; Thanh Toán ✓"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>
