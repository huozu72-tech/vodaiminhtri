<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- User Info Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_header_button"
                android:contentDescription="Avatar"
                android:padding="10dp"
                android:src="@drawable/ic_user"
                app:tint="@color/primary_orange" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Nguyễn Văn A" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    tools:text="SĐT: 0901234567" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_text"
                    android:textSize="11sp"
                    tools:text="Email: khachhang@restaurant.com" />
            </LinearLayout>
        </LinearLayout>

        <!-- Thẻ Hạng Thành Viên VIP & Điểm Thưởng Tích Lũy (Loyalty Program) -->
        <LinearLayout
            android:id="@+id/cardVipLoyalty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFBEB"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProfileLoyaltyTier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🥇 VIP Vàng (Gold)"
                    android:textColor="#92400E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileLoyaltyPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 75 điểm • Giảm tự động 5%"
                    android:textColor="#D97706"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressLoyaltyTier"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progress="60"
                app:indicatorColor="#F59E0B"
                app:trackColor="#FDE68A"
                app:trackCornerRadius="3dp" />

            <TextView
                android:id="@+id/tvProfileLoyaltyNextHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tổng chi tiêu: 750.000 đ • Còn 750.000 đ để lên 💎 VIP Kim Cương"
                android:textColor="#78350F"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Editable Profile Form (Hình 24 - Cập nhật hồ sơ cá nhân) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="✏️ Cập Nhật Thông Tin Hồ Sơ Cá Nhân"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileFullName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_input"
            android:hint="Họ và tên khách hàng"
            android:inputType="textPersonName"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:hint="Email liên hệ"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etProfileAddress"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:hint="Bàn ưu tiên / Địa chỉ giao hàng (VD: Bàn 08)"
            android:inputType="textPostalAddress"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etProfileNewPassword"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:hint="Đổi mật khẩu mới (Để trống nếu giữ nguyên)"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ai_button_orange"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="💾 Lưu Cập Nhật Hồ Sơ"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <!-- Orders Section Header (UC-06: Theo dõi đơn hàng) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📜 Theo Dõi &amp; Lịch Sử Đơn Hàng Của Bạn"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Container for order items -->
        <LinearLayout
            android:id="@+id/layoutCustomerOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoOrdersHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                android:gravity="center"
                android:text="Bạn chưa có đơn hàng nào."
                android:textColor="@color/gray_text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#E2E8F0" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutCustomer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Đăng Xuất"
                android:textAllCaps="false"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="#DC2626" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseProfile"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_orange"
                android:text="Đóng"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
