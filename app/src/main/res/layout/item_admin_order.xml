<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Row: Order ID, Table, Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="#ORD-1024 • Bàn 12" />

            <TextView
                android:id="@+id/tvOrderStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_mon_phu"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_mon_phu_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Đang Chờ" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            tools:text="Thời gian: 17:45 • Chuyển khoản QR" />

        <TextView
            android:id="@+id/tvOrderItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/black"
            android:textSize="13sp"
            tools:text="Món: Chân Giò Muối Chiên Giòn x1, 7Up x2" />

        <!-- Price, View Detail & Change Status Buttons (Hình 29) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderTotalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/price_red"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="150.000 đ" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOrderDetail"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="📄 Chi Tiết"
                android:textAllCaps="false"
                android:textColor="@color/admin_blue_accent"
                android:textSize="11sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/admin_blue_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeStatus"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="@color/admin_blue_accent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="Cập Nhật Trạng Thái"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
