<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatBubbleContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvChatMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_button"
        android:maxWidth="280dp"
        android:padding="12dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/black"
        android:textSize="13sp"
        tools:text="Xin chào! Tôi có thể giúp bạn chọn món ngon phù hợp hôm nay." />

    <!-- Container for dynamic AI suggested food cards inside the chat bubble -->
    <LinearLayout
        android:id="@+id/layoutSuggestedItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>