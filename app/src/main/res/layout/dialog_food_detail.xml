<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Image + Close Button + Category Badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#FFF3E0">

            <ImageView
                android:id="@+id/imgDetailFood"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh món ăn"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder" />

            <TextView
                android:id="@+id/tvDetailCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_badge_mon_chinh"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/badge_mon_chinh_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Món chính" />

            <TextView
                android:id="@+id/btnCloseDetail"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_header_button"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailFoodName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Chân Giò Muối Chiên Giòn" />

                <TextView
                    android:id="@+id/tvDetailFoodPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/price_red"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="120.000 đ" />
            </LinearLayout>

            <!-- Rating & Order Count + Taste Attributes -->
            <TextView
                android:id="@+id/tvDetailRatingSold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="⭐ 4.9 / 5.0 • 🔥 Đã phục vụ 210 phần" />

            <TextView
                android:id="@+id/tvDetailTasteTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ai_button_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🏷️ Hương vị: Đậm đà • Giòn rụm" />

            <!-- Detailed Description -->
            <TextView
                android:id="@+id/tvDetailFoodDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/gray_text"
                android:textSize="13sp"
                tools:text="Chân giò heo rút xương ướp muối hồng tiêu sọ, chiên giòn bì vàng rụm, ăn kèm kim chi củ cải chua ngọt." />

            <!-- UC-07: Đánh giá món ăn (1-5 sao) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFFBEB"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvRatingFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Đánh giá chất lượng món ăn (Chạm để chấm điểm):"
                    android:textColor="#92400E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRate1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="1★"
                        android:textColor="#D97706"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#F59E0B" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRate2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="2★"
                        android:textColor="#D97706"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#F59E0B" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRate3"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="3★"
                        android:textColor="#D97706"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#F59E0B" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRate4"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="4★"
                        android:textColor="#D97706"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#F59E0B" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRate5"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F59E0B"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="5★"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- AI Similar Dishes Section (Hình 10 Activity Diagram) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="✨ Món Tương Tự Gợi Ý Bởi Hệ Thống AI"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutSimilarDishesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Quantity Selector & Add to Cart Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailMinus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="44dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <TextView
                    android:id="@+id/tvDetailQuantity"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailPlus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="44dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailAddToCart"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_orange"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🛒 Thêm Vào Giỏ • 120.000 đ"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
